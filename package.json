{
    "name": "budget-forecaster",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
        "build": "vite build && vite build --config vite.worker.config.js && node scripts/dedupe-worker-asset.mjs && node scripts/inject-worker.mjs && rm -rf dist-worker/ dist/*.js",
        "test": "node --test test/*.test.mjs",
        "format:check": "prettier --check package.json index.html src test"
    },
    "devDependencies": {
        "@electric-sql/pglite": "0.5.10",
        "playwright": "1.64.1",
        "prettier": "3.9.10",
        "vite": "8.3.4",
        "vite-plugin-singlefile": "^2.3.4"
    }
}